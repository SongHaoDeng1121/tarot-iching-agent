# Copy values into Community Cloud -> App settings -> Secrets.
# These are placeholders, never paste real values into Git.
SILICONFLOW_API_KEY = "REPLACE_WITH_PRIVATE_VALUE"
DEEPSEEK_API_KEY = "REPLACE_WITH_PRIVATE_VALUE"
DEEPSEEK_MODEL = "deepseek-chat"
APP_ACCESS_PASSWORD = "REPLACE_WITH_RANDOM_SECRET_AT_LEAST_20_CHARACTERS"
KNOWLEDGE_BUNDLE_URL = "https://private-object-storage.example/authorized-knowledge.tar.gz"
KNOWLEDGE_BUNDLE_SHA256 = "REPLACE_WITH_64_HEX_CHECKSUM"
# Optional if your HTTPS service accepts bearer authentication.
# KNOWLEDGE_BUNDLE_TOKEN = "REPLACE_WITH_PRIVATE_VALUE"
# Alternative to a bundle: an existing private mounted directory containing data/ and storage/.
# KNOWLEDGE_ROOT = "/private/mounted/knowledge"
APP_RUNTIME_DIR = "/tmp/tarot-private-runtime"
API_GLOBAL_DAILY_UNITS = 160
API_SESSION_DAILY_UNITS = 24
API_COOLDOWN_SECONDS = 30
API_MAX_CONCURRENT = 2
